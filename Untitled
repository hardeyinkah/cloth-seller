.hero {
  height: 100vh;
  background: linear-gradient(120deg, rgba(0,0,0,0.7), rgba(0,0,0,0.3)),
              url('https://images.unsplash.com/photo-1521334884684-d80222895322');
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 8%;
  color: #fff;
}

.hero-content {
  max-width: 500px;
  animation: fadeSlide 1.2s ease;
}

.hero h1 {
  font-size: 4rem;
  line-height: 1.1;
}

.hero p {
  margin: 20px 0;
  font-size: 1.2rem;
  opacity: 0.9;
}